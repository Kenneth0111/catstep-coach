page {
  min-height: 100%;
  background: #f7f0df;
  color: #3f3a31;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
}

button {
  min-height: 44px;
}

.primary-action {
  background: #356f63;
  color: #f7f0df;
}

.primary-action:active {
  background: #2d5e54;
}

.accent-text {
  color: #8a641c;
}

.accent-mark {
  background: #d5a63f;
}
