.bottom-nav {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #ded4c1;
  background: #fffaf0;
  box-shadow: 0 -8rpx 20rpx rgba(91, 76, 49, 0.08);
}

.bottom-nav--fixed {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
}

.nav-item {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 104rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 8rpx 6rpx;
  border-radius: 52rpx;
  border: 0;
  background: transparent;
  color: #71695d;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  transition: opacity 160ms ease, background-color 160ms ease;
}

.nav-item:active {
  opacity: 0.72;
  background-color: #f1e8d8;
}

.nav-item::after {
  border: 0;
}

.nav-item.is-active {
  background: transparent;
  color: #5f481e;
  font-weight: 700;
}

.nav-item.is-active:active {
  background-color: #f1e8d8;
}

.nav-paw {
  position: relative;
  width: 104rpx;
  height: 86rpx;
  transform: rotate(-2deg);
}

.nav-paw__art {
  display: block;
  width: 104rpx;
  height: 86rpx;
}

.nav-label {
  display: block;
  line-height: 1.3;
}

.nav-label--active {
  position: absolute;
  top: 70%;
  left: 50%;
  min-width: 52rpx;
  color: #5f481e;
  font-size: 22rpx;
  line-height: 1;
  text-align: center;
  transform: translate(-50%, -50%) rotate(2deg);
  white-space: nowrap;
}
