:host {
  display: block;
}

.task-card {
  padding: 26rpx;
  border: 2rpx solid #d6cdb9;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.76);
}

.task-card--in_progress {
  border-color: #356f63;
  box-shadow: 0 8rpx 20rpx rgba(53, 111, 99, 0.08);
}

.task-card--completed {
  border-style: dashed;
  color: #71695d;
}

.task-card__body {
  display: flex;
  flex-direction: column;
}

.task-card__title {
  color: #3f3a31;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.task-card__meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  color: #625c52;
  font-size: 24rpx;
}

.task-card__status {
  color: #356f63;
  font-weight: 600;
}

.task-card__button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #356f63;
  color: #f7f0df;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.task-card__button::after {
  border: 0;
}

.task-card__button--pressed {
  background: #2d5e54;
  transform: translateY(2rpx);
}

.task-card__choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.task-card__choice,
.task-card__secondary {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 128rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 2rpx solid #9a927f;
  border-radius: 14rpx;
  background: transparent;
  color: #625c52;
  font-size: 26rpx;
  line-height: 1.4;
}

.task-card__choice::after,
.task-card__secondary::after {
  border: 0;
}

.task-card__secondary {
  width: 100%;
  margin-top: 14rpx;
}

.task-card__blocked {
  display: block;
  margin-top: 14rpx;
  color: #8a641c;
  font-size: 26rpx;
  line-height: 1.5;
}

.task-card__feedback {
  margin-top: 20rpx;
  color: #625c52;
  font-size: 26rpx;
}

.task-card__difficulty--selected {
  border-color: #356f63;
  background: #dcece4;
  color: #24594e;
  font-weight: 700;
}

@media (max-width: 340px) {
  .task-card {
    padding: 22rpx;
  }

  .task-card__meta {
    align-items: flex-start;
    flex-direction: column;
    gap: 4rpx;
  }

  .task-card__choice {
    min-width: 0;
    flex-basis: calc(50% - 6rpx);
  }

  .task-card__difficulty {
    flex-basis: 100%;
  }
}
