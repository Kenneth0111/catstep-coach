.today-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx calc(176rpx + env(safe-area-inset-bottom));
}

.intro,
.section {
  display: flex;
  flex-direction: column;
}

.intro {
  margin-bottom: 48rpx;
}

.eyebrow {
  align-self: flex-start;
  margin-bottom: 12rpx;
  padding-bottom: 4rpx;
  border-bottom: 6rpx solid #d5a63f;
  color: #356f63;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.title {
  margin-bottom: 8rpx;
  color: #3f3a31;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.35;
}

.summary {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: #625c52;
  font-size: 32rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goal-card {
  overflow: hidden;
  border: 2rpx solid #d6cdb9;
  border-radius: 16rpx;
  background: #fffaf0;
}

.goal-card.is-expanded {
  border-color: #356f63;
  box-shadow: 0 8rpx 20rpx rgba(53, 111, 99, 0.12);
}

.goal-card__toggle {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 88rpx;
  padding: 28rpx 30rpx;
}

.goal-card__marker {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
  color: #d5a63f;
  transform: rotate(-12deg);
}

.paw-toe,
.paw-pad {
  position: absolute;
  border: 3rpx solid currentColor;
  background: #fffaf0;
}

.paw-toe {
  top: 0;
  left: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: -15rpx 9rpx 0 -2rpx #fffaf0, 15rpx 9rpx 0 -2rpx #fffaf0;
}

.paw-pad {
  bottom: 1rpx;
  left: 8rpx;
  width: 24rpx;
  height: 18rpx;
  border-radius: 48% 48% 58% 58%;
}

.goal-card.is-expanded .paw-toe,
.goal-card.is-expanded .paw-pad {
  background: currentColor;
}

.goal-card__main {
  flex: 1;
  min-width: 0;
}

.goal-card__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.goal-card__title {
  color: #3f3a31;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}

.goal-card__status {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border: 2rpx solid #d5a63f;
  border-radius: 999rpx;
  color: #8a641c;
  font-size: 24rpx;
  font-weight: 700;
}

.goal-card__progress {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eadfc9;
}

.goal-card__progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #356f63;
}

.goal-card__count {
  display: block;
  margin-top: 10rpx;
  color: #625c52;
  font-size: 26rpx;
}

.goal-card__content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 0 30rpx 30rpx;
}

.goal-card__error {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 30rpx 24rpx;
  padding: 22rpx 24rpx;
  border: 2rpx dashed #d5a63f;
  border-radius: 12rpx;
  background: rgba(213, 166, 63, 0.1);
  color: #8a641c;
  font-size: 26rpx;
  line-height: 1.5;
}

.section + .section {
  margin-top: 28rpx;
}

.section-label {
  margin-bottom: 16rpx;
  color: #356f63;
  font-size: 34rpx;
  font-weight: 700;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  border: 2rpx dashed #9a927f;
  border-radius: 16rpx;
  color: #625c52;
}

.empty-title {
  margin-bottom: 8rpx;
  color: #356f63;
  font-size: 34rpx;
  font-weight: 700;
}

.state-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 40rpx 32rpx;
  border: 2rpx dashed #9a927f;
  border-radius: 16rpx;
  background: #fffaf0;
  color: #625c52;
}

.state-title {
  color: #356f63;
  font-size: 34rpx;
  font-weight: 700;
}

.state-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #356f63;
  color: #f7f0df;
  font-size: 30rpx;
}

.state-action::after {
  border: 0;
}

.error-state {
  border-color: #d5a63f;
}

.review-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 32rpx;
  border: 2rpx solid #d5a63f;
  border-radius: 16rpx;
  background: #fffaf0;
  color: #625c52;
  line-height: 1.6;
}

.reminder-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 40rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #d5a63f;
  border-radius: 16rpx;
  background: #fffaf0;
  color: #625c52;
}

.reminder-title {
  color: #356f63;
  font-size: 32rpx;
  font-weight: 700;
}

.reminder-message {
  color: #625c52;
  font-size: 26rpx;
}

.add-goal-action {
  margin-top: 28rpx;
}

.capacity-note {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border: 2rpx dashed #d5a63f;
  border-radius: 16rpx;
  background: #fffaf0;
  color: #8a641c;
  font-size: 28rpx;
  line-height: 1.5;
}
