.today-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 32rpx calc(176rpx + env(safe-area-inset-bottom));
}

.intro,
.section,
.state-card,
.empty-state,
.review-card {
  display: flex;
  flex-direction: column;
}

.intro {
  margin-bottom: 28rpx;
}

.intro-meta,
.intro-title-row,
.summary-metric__line,
.reminder-card,
.reminder-card__heading,
.goal-toolbar,
.goal-toolbar__heading,
.goal-card__toggle,
.goal-card__heading,
.goal-card__progress-row {
  display: flex;
  align-items: center;
}

.intro-meta,
.intro-title-row,
.goal-toolbar,
.goal-card__heading {
  justify-content: space-between;
}

.eyebrow {
  color: #625c52;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.intro-badge {
  padding: 8rpx 18rpx;
  border: 2rpx solid #d6cdb9;
  border-radius: 999rpx;
  color: #625c52;
  font-size: 23rpx;
  line-height: 1.3;
}

.intro-paw,
.empty-goals__paw {
  position: relative;
  width: 44rpx;
  height: 38rpx;
  color: #356f63;
  transform: rotate(-12deg);
}

.intro-paw__toe,
.intro-paw__pad {
  position: absolute;
  border: 4rpx solid currentColor;
  background: #f7f0df;
}

.intro-paw__toe {
  top: 0;
  left: 15rpx;
  width: 10rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: -14rpx 8rpx 0 -2rpx #f7f0df, 14rpx 8rpx 0 -2rpx #f7f0df;
}

.intro-paw__pad {
  right: 7rpx;
  bottom: 0;
  width: 24rpx;
  height: 18rpx;
  border-radius: 48% 48% 58% 58%;
}

.greeting {
  margin-top: 18rpx;
  color: #625c52;
  font-size: 30rpx;
  line-height: 1.4;
}

.intro-title-row {
  gap: 20rpx;
  margin-top: 4rpx;
}

.title {
  min-width: 0;
  flex: 1;
  color: #3f3a31;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.28;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 28rpx;
  padding: 28rpx 12rpx;
  border: 2rpx solid #d6cdb9;
  border-radius: 28rpx;
  background: #fffaf0;
  box-shadow: 0 10rpx 28rpx rgba(91, 76, 49, 0.08);
}

.summary-metric {
  min-width: 0;
  padding: 0 20rpx;
}

.summary-metric + .summary-metric {
  border-left: 2rpx solid #ded4c1;
}

.summary-metric__line {
  min-height: 52rpx;
  align-items: baseline;
  gap: 6rpx;
}

.summary-metric__value {
  color: #3f3a31;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.15;
}

.summary-metric__unit,
.summary-metric__label {
  color: #625c52;
  font-size: 24rpx;
}

.summary-metric__label {
  display: block;
  margin-top: 8rpx;
  line-height: 1.35;
}

.state-card {
  align-items: center;
  gap: 12rpx;
  padding: 52rpx 36rpx;
  border: 2rpx solid #d6cdb9;
  border-radius: 28rpx;
  background: #fffaf0;
  color: #625c52;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(91, 76, 49, 0.08);
}

.state-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  color: #d5a63f;
  font-size: 40rpx;
  font-weight: 700;
}

.state-title {
  color: #356f63;
  font-size: 34rpx;
  font-weight: 700;
}

.state-action,
.inline-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 18rpx;
  background: #356f63;
  color: #f7f0df;
  font-size: 30rpx;
  font-weight: 600;
}

.state-action {
  width: 100%;
  margin-top: 22rpx;
}

.state-action::after,
.inline-action::after,
.reminder-action::after,
.add-goal-action::after {
  border: 0;
}

.reminder-card {
  box-sizing: border-box;
  min-height: 112rpx;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 40rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #d6cdb9;
  border-radius: 22rpx;
  background: rgba(255, 250, 240, 0.72);
  color: #625c52;
}

.reminder-card__main {
  flex: 1;
  min-width: 0;
}

.reminder-card__heading {
  gap: 12rpx;
}

.reminder-dot {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 auto;
  border: 2rpx solid #d5a63f;
  border-radius: 50%;
}

.reminder-title {
  color: #3f3a31;
  font-size: 30rpx;
  font-weight: 700;
}

.reminder-copy,
.reminder-message {
  display: block;
  margin-top: 4rpx;
  color: #625c52;
  font-size: 26rpx;
  line-height: 1.45;
}

.reminder-action,
.add-goal-action,
.inline-action {
  box-sizing: border-box;
  margin: 0;
  border: 2rpx solid #356f63;
  background: transparent;
  color: #356f63;
}

.reminder-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 144rpx;
  min-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
}

.reminder-message {
  width: 100%;
  margin-top: 0;
  padding-left: 26rpx;
}

.goal-toolbar {
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.goal-toolbar__copy {
  min-width: 0;
}

.goal-toolbar__heading {
  flex-wrap: wrap;
  gap: 12rpx;
}

.goal-toolbar__title {
  color: #3f3a31;
  font-size: 38rpx;
  font-weight: 700;
}

.goal-toolbar__capacity {
  color: #8a641c;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.add-goal-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  flex: 0 0 auto;
  padding: 0 22rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
}

.empty-goals {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 148rpx;
  box-sizing: border-box;
  padding: 28rpx 30rpx;
  border: 2rpx dashed #d6cdb9;
  border-radius: 28rpx;
  background: rgba(255, 250, 240, 0.62);
  color: #625c52;
}

.empty-goals__paw {
  flex: 0 0 auto;
}

.empty-goals__copy {
  min-width: 0;
}

.empty-goals__title,
.empty-goals__hint {
  display: block;
}

.empty-goals__title {
  color: #356f63;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-goals__hint {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.capacity-note {
  margin-bottom: 22rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed #d5a63f;
  border-radius: 18rpx;
  background: rgba(213, 166, 63, 0.1);
  color: #8a641c;
  font-size: 26rpx;
  line-height: 1.5;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goal-card {
  overflow: hidden;
  border: 2rpx solid #d6cdb9;
  border-radius: 28rpx;
  background: #fffaf0;
  box-shadow: 0 8rpx 22rpx rgba(91, 76, 49, 0.06);
}

.goal-card.is-expanded {
  border-color: #c1b59f;
  box-shadow: 0 12rpx 30rpx rgba(53, 111, 99, 0.1);
}

.goal-card__toggle {
  box-sizing: border-box;
  min-height: 88rpx;
  gap: 20rpx;
  padding: 28rpx 28rpx 26rpx;
}

.goal-card__marker {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
  color: #356f63;
  transform: rotate(-12deg);
}

.paw-toe,
.paw-pad {
  position: absolute;
  border: 3rpx solid currentColor;
  background: #fffaf0;
}

.paw-toe {
  top: 0;
  left: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: -15rpx 9rpx 0 -2rpx #fffaf0, 15rpx 9rpx 0 -2rpx #fffaf0;
}

.paw-pad {
  bottom: 1rpx;
  left: 8rpx;
  width: 24rpx;
  height: 18rpx;
  border-radius: 48% 48% 58% 58%;
}

.goal-card.is-expanded .paw-toe,
.goal-card.is-expanded .paw-pad {
  background: currentColor;
}

.goal-card__main {
  flex: 1;
  min-width: 0;
}

.goal-card__heading {
  align-items: flex-start;
  gap: 14rpx;
}

.goal-card__title {
  min-width: 0;
  color: #3f3a31;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.42;
  overflow-wrap: anywhere;
}

.goal-card__status {
  flex: 0 0 auto;
  color: #356f63;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.55;
}

.goal-card__status--completed {
  color: #8a641c;
}

.goal-card__progress-row {
  gap: 14rpx;
  margin-top: 16rpx;
}

.goal-card__progress {
  height: 12rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e7decb;
}

.goal-card__progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #356f63;
}

.goal-card__count {
  flex: 0 0 auto;
  color: #625c52;
  font-size: 24rpx;
  white-space: nowrap;
}

.goal-card__chevron {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 auto;
  border-right: 3rpx solid #625c52;
  border-bottom: 3rpx solid #625c52;
  transform: rotate(45deg) translateY(-3rpx);
  transition: transform 160ms ease;
}

.goal-card__chevron.is-open {
  transform: rotate(225deg) translate(-2rpx, -2rpx);
}

.goal-card__content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 28rpx 30rpx 68rpx;
}

.goal-path {
  position: absolute;
  top: 0;
  bottom: 34rpx;
  left: 46rpx;
  border-left: 2rpx dashed #c8bca5;
}

.goal-card__error {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 28rpx 24rpx;
  padding: 22rpx 24rpx;
  border: 2rpx dashed #d5a63f;
  border-radius: 16rpx;
  background: rgba(213, 166, 63, 0.1);
  color: #8a641c;
  font-size: 26rpx;
  line-height: 1.5;
}

.inline-action {
  align-self: flex-start;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.section + .section {
  margin-top: 2rpx;
}

.section-label {
  margin-bottom: 14rpx;
  color: #356f63;
  font-size: 28rpx;
  font-weight: 700;
}

.section-label--muted {
  color: #625c52;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-state {
  margin-top: 30rpx;
  padding: 38rpx 32rpx;
  border: 2rpx dashed #d5a63f;
  border-radius: 24rpx;
  background: rgba(255, 250, 240, 0.68);
  color: #625c52;
}

.empty-kicker {
  color: #8a641c;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.empty-title {
  margin: 6rpx 0;
  color: #356f63;
  font-size: 36rpx;
  font-weight: 700;
}

.error-state {
  border-color: #d5a63f;
}

.review-card {
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid #d5a63f;
  border-radius: 20rpx;
  background: #fffaf0;
  color: #625c52;
  line-height: 1.6;
}

@media (max-width: 340px) {
  .today-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .summary-grid {
    padding-right: 4rpx;
    padding-left: 4rpx;
  }

  .summary-metric {
    padding: 0 12rpx;
  }

  .summary-metric__value {
    font-size: 36rpx;
  }

  .summary-metric__unit,
  .summary-metric__label {
    font-size: 22rpx;
  }

  .reminder-card,
  .goal-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .reminder-action,
  .add-goal-action {
    width: 100%;
  }

  .goal-card__content {
    padding-left: 52rpx;
  }

  .goal-path {
    left: 34rpx;
  }

  .goal-card__progress-row {
    flex-wrap: wrap;
  }
}
